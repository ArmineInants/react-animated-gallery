{
  "name": "react-animated-gallery",
  "version": "0.1.7",
  "description": "React image gallery and carousel: three circular slots (left, center, right), smooth slot cycling, typed theme API, CSS animations. Works with Vite and Next.js (client-only).",
  "author": "Armine Inants",
  "keywords": [
    "react",
    "react-component",
    "gallery",
    "image-gallery",
    "animated-gallery",
    "carousel",
    "slideshow",
    "animation",
    "css-animation",
    "spotlight",
    "nextjs",
    "next.js",
    "vite",
    "typescript",
    "css-modules"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmineInants/react-animated-gallery.git"
  },
  "homepage": "https://react-animated-gallery.vercel.app/",
  "bugs": {
    "url": "https://github.com/ArmineInants/react-animated-gallery/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/animated-gallery.cjs",
  "module": "./dist/animated-gallery.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/animated-gallery.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/animated-gallery.cjs"
      }
    },
    "./style.css": "./dist/animated-gallery.css"
  },
  "files": [
    "dist", 
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "demo": "npm run build && npm install --prefix demo && npm run dev --prefix demo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  }
}
